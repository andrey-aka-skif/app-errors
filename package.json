{
  "name": "@andrey-aka-skif/app-errors",
  "version": "0.0.0",
  "description": "Классы ошибок приложения, связанные с обращением к внешнему API и внутренней логикой",
  "keywords": [
    "errors",
    "error-handling",
    "http",
    "api",
    "axios",
    "superagent"
  ],
  "license": "MIT",
  "author": "@andrey-aka-skif",
  "homepage": "https://github.com/andrey-aka-skif/app-errors",
  "bugs": {
    "url": "https://github.com/andrey-aka-skif/app-errors/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrey-aka-skif/app-errors.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.1.39",
    "@vitest/ui": "^3.1.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.0.0",
    "prettier": "^3.7.4",
    "terser": "^5.44.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@andrey-aka-skif/app-errors",
  "version": "0.0.0",
  "description": "Классы ошибок приложения, связанные с обращением к внешнему API и внутренней логикой",
  "keywords": [
    "errors",
    "error-handling",
    "http",
    "api",
    "axios",
    "superagent"
  ],
  "license": "MIT",
  "author": "@andrey-aka-skif",
  "homepage": "https://github.com/andrey-aka-skif/app-errors",
  "bugs": {
    "url": "https://github.com/andrey-aka-skif/app-errors/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrey-aka-skif/app-errors.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "prettier --check .",
    "build": "vite build",
    "postbuild": "node scripts/verify-dist.js",
    "verify:dist": "node scripts/verify-dist.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc --options docs/typedoc.config.mjs",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "terser": "^5.50.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^4.1.10"
  }
}
